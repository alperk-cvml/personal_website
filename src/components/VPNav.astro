---
export interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<header class="vp-nav">
  <div class="vp-nav-brand">
    <span class="vp-user">alper</span>@lab:~$ <span class="vp-cmd">./visualpaws</span>
  </div>
  <nav class="vp-nav-links">
    <a href="/log" class={current === 'log' ? 'active' : ''}>/log</a>
    <a href="/project" class={current === 'project' ? 'active' : ''}>/project</a>
    <a href="/setup" class={current === 'setup' ? 'active' : ''}>/setup</a>
    <a href="/about" class={current === 'about' ? 'active' : ''}>/about</a>
  </nav>
</header>

<style>
  .vp-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    border-bottom: 1px solid #1e231d;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: #8a9088;
  }

  .vp-user { color: #d8ff3e; }
  .vp-cmd { color: #d6e0d4; }

  .vp-nav-links {
    display: flex;
    gap: 28px;
    font-size: 13px;
  }

  .vp-nav-links a {
    color: #8a9088;
  }

  .vp-nav-links a:hover,
  .vp-nav-links a.active {
    color: #d8ff3e;
  }

  @media (max-width: 640px) {
    .vp-nav {
      padding: 14px 20px;
    }

    .vp-nav-brand {
      font-size: 12px;
    }

    .vp-nav-links {
      gap: 16px;
      font-size: 12px;
    }
  }
</style>
