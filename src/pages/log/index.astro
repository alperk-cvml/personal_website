---
import VPLayout from '../../layouts/VPLayout.astro';
import VPNav from '../../components/VPNav.astro';
import VPFooter from '../../components/VPFooter.astro';
import { getCollection } from 'astro:content';
import readingTime from 'reading-time';

let allPosts = await getCollection('posts');
allPosts = allPosts.sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);

const TAGS = ['ALL', 'VISION', 'GAIT', 'HARDWARE', 'FIRMWARE', 'NOTES'];

function formatDate(d) {
  const date = typeof d === 'string' ? new Date(d) : d;
  return date.toISOString().slice(0, 10);
}
---

<VPLayout title="Build Log — VisualPaws" description="All build log entries for VisualPaws">
  <div class="vp-page">
    <VPNav current="log" />

    <section class="log-header">
      <h1>ls posts/ <span class="log-count">— {allPosts.length} entries</span></h1>
      <div class="tag-filters">
        {TAGS.map((t) => (
          <button
            class={`tag-btn${t === 'ALL' ? ' active' : ''}`}
            data-tag={t}
          >
            {t}
          </button>
        ))}
      </div>
    </section>

    <section class="post-list">
      {allPosts.map((post) => {
        const href = `/log/${post.data.slug}`;
        const date = formatDate(post.data.publishDate);
        const tag = post.data.tag || 'NOTES';
        const mins = Math.ceil(readingTime(post.body).minutes);
        return (
          <a href={href} class="post-row" data-tag={tag}>
            <span class="post-date">{date}</span>
            <span class="post-tag">{tag}</span>
            <span class="post-title">{post.data.title}</span>
            <span class="post-read">{mins} min →</span>
          </a>
        );
      })}
    </section>

    <VPFooter />
  </div>
</VPLayout>

<script>
  const buttons = document.querySelectorAll('.tag-btn');
  const rows = document.querySelectorAll('.post-row');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const selected = btn.dataset.tag;
      rows.forEach((row) => {
        const show = selected === 'ALL' || row.dataset.tag === selected;
        (row as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
  .vp-page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* ── header ── */
  .log-header {
    padding: 48px 40px 16px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  h1 {
    font-size: 34px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #d6e0d4;
  }

  .log-count {
    color: #5c6359;
    font-weight: 400;
    font-size: 16px;
  }

  .tag-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tag-btn {
    background: transparent;
    border: 1px solid #3a4038;
    color: #a8b0a4;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    padding: 5px 14px;
    cursor: pointer;
  }

  .tag-btn:hover {
    border-color: #d8ff3e;
    color: #d8ff3e;
  }

  .tag-btn.active {
    background: #d8ff3e;
    border-color: #d8ff3e;
    color: #0c0e0c;
    font-weight: 700;
  }

  /* ── list ── */
  .post-list {
    padding: 16px 40px 48px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-row {
    display: grid;
    grid-template-columns: 120px 110px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid #1e231d;
  }

  .post-row:hover {
    background: #101310;
  }

  .post-date {
    font-size: 12px;
    color: #5c6359;
  }

  .post-tag {
    font-size: 11px;
    color: #d8ff3e;
    border: 1px solid #2c3520;
    padding: 2px 8px;
    text-align: center;
    white-space: nowrap;
  }

  .post-title {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 17px;
    color: #e6ede3;
  }

  .post-read {
    font-size: 12px;
    color: #5c6359;
    white-space: nowrap;
  }

  /* ── responsive ── */
  @media (max-width: 900px) {
    .log-header {
      padding: 32px 20px 12px;
    }

    h1 {
      font-size: 24px;
    }

    .post-list {
      padding: 12px 20px 40px;
    }

    .post-row {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 8px 16px;
    }

    .post-date {
      grid-column: 1;
      grid-row: 2;
    }

    .post-tag {
      grid-column: 2;
      grid-row: 2;
    }

    .post-title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .post-read {
      display: none;
    }
  }
</style>
